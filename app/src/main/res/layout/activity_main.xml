<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="end|center_vertical"
        android:padding="20dp"
        android:text="0"
        android:textSize="40sp"
        android:textColor="#111111"
        android:background="#FFFFFF" />

    <Space android:layout_width="1dp" android:layout_height="12dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4">

        <Button android:text="C" android:onClick="clearClick" style="@style/CalcButton"/>
        <Button android:text="÷" android:onClick="operatorClick" style="@style/CalcButton"/>
        <Button android:text="×" android:onClick="operatorClick" style="@style/CalcButton"/>
        <Button android:text="−" android:onClick="operatorClick" style="@style/CalcButton"/>

        <Button android:text="7" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="8" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="9" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="+" android:onClick="operatorClick" style="@style/CalcButton"/>

        <Button android:text="4" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="5" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="6" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="1" android:onClick="numberClick" style="@style/CalcButton"/>

        <Button android:text="1" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="2" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="3" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="=" android:onClick="equalsClick" style="@style/CalcButton"/>

        <Button android:text="0" android:onClick="numberClick" style="@style/CalcButton"/>
        <Button android:text="." android:onClick="numberClick" style="@style/CalcButton"/>
    </GridLayout>
</LinearLayout>
